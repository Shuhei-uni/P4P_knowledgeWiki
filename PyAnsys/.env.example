# Option A: point to a copied Fluent server-info file on this laptop.
FLUENT_SERVER_INFO_FILE=

# Preferred self-healing workflow: private shared bridge visible to the laptop
# and Fluent PC. Each machine may map the same share to a different local path.
FLUENT_BRIDGE_DIR=
FLUENT_ADVERTISED_HOST=
FLUENT_CONNECTION_MAX_AGE_SECONDS=45

# Direct fallback: set these instead of FLUENT_SERVER_INFO_FILE.
FLUENT_IP=
FLUENT_PORT=
FLUENT_PASSWORD=

# Option C: local manual launch fallback for environments like Student Edition.
# When set, connection.py starts fluent.exe directly, keeps stdin open, and
# connects through the generated server-info file.
FLUENT_LOCAL_EXE=
FLUENT_LOCAL_PROCESSOR_COUNT=2
FLUENT_LOCAL_DIMENSION=3
FLUENT_LOCAL_PRECISION=double
FLUENT_LOCAL_GUI=false
FLUENT_LOCAL_STARTUP_TIMEOUT=120
FLUENT_LOCAL_OUTPUT_DIR=
FLUENT_WATCHDOG_WORK_DIR=
FLUENT_WATCHDOG_MAX_RESTARTS=3
FLUENT_WATCHDOG_RESTART_WINDOW_SECONDS=600
FLUENT_WATCHDOG_HEALTH_INTERVAL_SECONDS=10
FLUENT_WATCHDOG_HEALTH_TIMEOUT_SECONDS=10
FLUENT_WATCHDOG_RESTART_DELAY_SECONDS=5

# Keep this enabled when the Fluent server is running on another machine.
FLUENT_ALLOW_REMOTE_HOST=true

# Leave false unless you intentionally need insecure mode for troubleshooting.
FLUENT_INSECURE_MODE=false

# Paths below are on the Fluent PC, not on this laptop.
FLUENT_REMOTE_PROJECT_DIR=
FLUENT_REMOTE_CASE_DATA_DIR=
FLUENT_REMOTE_GEOM_DIR=
FLUENT_REMOTE_MESH_DIR=
FLUENT_REMOTE_CASE_FILE=
FLUENT_REMOTE_DATA_FILE=
FLUENT_REMOTE_GEOM_FILE=
FLUENT_REMOTE_MESH_FILE=
