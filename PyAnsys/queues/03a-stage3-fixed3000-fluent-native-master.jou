; 03A Stage-3 fixed-3000 Fluent-native queue
;
; This file is intentionally explicit.  Fluent owns every solve command.
; There is no Python iteration loop and no client-side stage polling.
;
; IMPORTANT:
;   - Run on the Fluent machine with the released P0 available at P0_SOURCE.
;   - All outputs below are local to C:/FluentRuns/03A-stage3.
;   - The five F11 transition files must exist before this journal is started:
;       F11-10pct.set, F11-20pct.set, F11-40pct.set,
;       F11-80pct.set, and F11-100pct.set
;     They must change both split-inlet velocity magnitudes together and leave
;     turbulence intensity and hydraulic diameter unchanged.
;   - Those settings files are read only at the F11 loading transitions.  They
;     are not a substitute for changing the physical boundary conditions.
;   - Do not edit P0_SOURCE or write any output under the OneDrive directory.
;   - Leave Fluent's invalid-command behavior at its default.  A bad transition
;     must not silently skip into a different scientific state.
;
; F11 velocity values represented by the settings files:
;   10% = 2.7118 m/s, 20% = 5.4236 m/s, 40% = 10.8472 m/s,
;   80% = 21.6944 m/s, 100% = 27.118 m/s, on both split inlets.
;
; Failure semantics:
;   A Fluent floating-point error may return control to this journal, or may
;   terminate the current command/session.  If control returns, the following
;   paired write and next explicit step are attempted.  If Fluent terminates
;   the solve/journal, no TUI journal can execute commands after that point;
;   native autosave is the recovery artifact.  No numerical rescue is applied.

/file/confirm-overwrite? no
/file/start-transcript "C:/FluentRuns/03A-stage3/03A-stage3-fixed3000-native.trn"
/solve/monitors/residual/print? yes
/solve/monitors/residual/plot? yes
/solve/monitors/residual/n-save 600

; -----------------------------------------------------------------------------
; F02: Schedule B, carrier-first, 100% inlet, momentum URF 0.7
; -----------------------------------------------------------------------------
/file/auto-save/case-frequency each-time
/file/auto-save/data-frequency 250
/file/auto-save/root-name "C:/FluentRuns/03A-stage3/F02/F02-autosave-%i"
/file/auto-save/retain-most-recent-files yes
/file/auto-save/max-files 2
/file/read-case "C:/Users/syok443/OneDrive - The University of Auckland/2026 Sem 2/700/Full geom/03A-stage3/03A-stage3-P0-monitor-ready-preinit.cas.h5"
/file/write-case "C:/FluentRuns/03A-stage3/F02/F02-P0-local.cas.h5"
/file/read-case "C:/FluentRuns/03A-stage3/F02/F02-P0-local.cas.h5"
/solve/set/under-relaxation/mom 0.7
/solve/set/equations mp no
/solve/set/equations drift no
/file/write-case "C:/FluentRuns/03A-stage3/F02/F02-B-preinit.cas.h5"
/solve/initialize/hyb-initialization
/file/write-case-data "C:/FluentRuns/03A-stage3/F02/F02-hybrid-initialized.cas.h5"
/solve/iterate 3000
/file/write-case-data "C:/FluentRuns/03A-stage3/F02/F02-carrier-3000.cas.h5"
/plot/residuals-set/plot-to-file "C:/FluentRuns/03A-stage3/F02/F02-carrier-3000-residuals.out"
/plot/residuals
/plot/residuals-set/end-plot-to-file
; F02 transition: no reinitialization.  Enable Volume Fraction and Slip Velocity.
/solve/set/equations mp yes
/solve/set/equations drift yes
/file/write-case-data "C:/FluentRuns/03A-stage3/F02/F02-full-mixture-transition.cas.h5"
/solve/iterate 3000
/file/write-case-data "C:/FluentRuns/03A-stage3/F02/F02-full-mixture-3000.cas.h5"
/plot/residuals-set/plot-to-file "C:/FluentRuns/03A-stage3/F02/F02-full-mixture-3000-residuals.out"
/plot/residuals
/plot/residuals-set/end-plot-to-file

